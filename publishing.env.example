# Configure the write token privately in GitHub environment env, never in client code.
BLOB_READ_WRITE_TOKEN=
# Exact public store hostname, without https:// or a path.
NOTES_BLOB_HOST=
# GitHub environment variable: blob or explicitly github-only.
NOTES_MEDIA_MODE=blob
# Existing GitHub environment secrets remain required.
REVALIDATE_SECRET_TOKEN=
PORTFOLIO_WEBHOOK_URL=
